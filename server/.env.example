# --- Digital CFO server sozlamalari ---
# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.

# Server porti
PORT=4000

# Muhit: development | production
NODE_ENV=development

# Production CORS — ruxsat etilgan domenlar (vergul bilan)
# Masalan: https://digitalcfo.uz,https://www.digitalcfo.uz
CORS_ORIGIN=

# /api/leads ni himoyalash uchun maxfiy token (header: x-admin-token)
# Bo'sh qoldirilsa, /api/leads faqat localhost'dan ochiladi.
ADMIN_TOKEN=

# Telegram bildirishnoma (yangi so'rov kelganda admin'ga xabar)
# Bot tokenini @BotFather, chat ID ni @userinfobot dan oling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot kunlik statistikani POST /api/stats orqali yuborishi uchun maxfiy token.
# Aynan shu qiymat botning konfiguratsiyasiga ham qo'yiladi.
STATS_TOKEN=
