# --- Digital CFO server sozlamalari ---
# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.

# Server porti
PORT=4000

# Muhit: development | production
NODE_ENV=development

# Production CORS — ruxsat etilgan domenlar (vergul bilan)
# Masalan: https://digitalcfo.uz,https://www.digitalcfo.uz
CORS_ORIGIN=

# /api/leads ni himoyalash uchun maxfiy token (header: x-admin-token)
# Bo'sh qoldirilsa, /api/leads faqat localhost'dan ochiladi.
ADMIN_TOKEN=

# Telegram bildirishnoma (yangi so'rov kelganda admin'ga xabar)
# Bot tokenini @BotFather, chat ID ni @userinfobot dan oling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Social avto-post (DCOS Faza 3b) — maqolalarni Telegram KANALGA joylash.
# Bu admin chatidan farqli — public kanal ID'si (masalan @digitalcfo yoki -1001234567890).
# Bot shu kanalда ADMIN bo'lishi kerak. Bo'sh bo'lsa — Telegram avto-post o'chiq.
TELEGRAM_CHANNEL_ID=

# Bot kunlik statistikani POST /api/stats orqali yuborishi uchun maxfiy token.
# Aynan shu qiymat botning konfiguratsiyasiga ham qo'yiladi.
STATS_TOKEN=

# --- Maqolalar admin paneli (/admin) ---
# Bu uchtasi TO'LDIRILMASA — admin panel o'chiq bo'ladi (login 503 qaytaradi).
# ADMIN_USERNAME — admin login (ixtiyoriy, standart: admin)
# ADMIN_PASSWORD — kuchli parol (majburiy)
# JWT_SECRET — token imzosi uchun uzun tasodifiy satr (majburiy)
#   Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=

# --- AI kontent generatori (/admin dagi DCOS yordamchisi) ---
# ANTHROPIC_API_KEY to'ldirilmasa — AI yordamchi jimgina o'chiq bo'ladi (panel yashiriladi).
# Kalitni https://console.anthropic.com dan oling.
ANTHROPIC_API_KEY=
# Model (ixtiyoriy). Standart: claude-sonnet-5. Yuqori sifat uchun: claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-5
